# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf

# Configuration files (CI workflows, packaging, citation metadata) -- these
# were previously left to the `text=auto` fallback even though sibling
# config-ish text formats below (*.json) get an explicit rule; a contributor
# without core.autocrlf=true committing a CI workflow edit could otherwise
# introduce CRLF into files GitHub Actions/Dependabot/Read the Docs parse.
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cff text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary

# Data files
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf
