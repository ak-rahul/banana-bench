# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# Jupyter notebooks
*.ipynb text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text

# Archives
*.zip binary
*.tar binary
*.gz binary

# Data files
*.csv text eol=lf
*.json text eol=lf
